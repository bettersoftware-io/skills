// Renovate: one wave of update pull requests a week, grouped, never for a
// release younger than a week.
//
// This file is yours. The add-on wrote it once and will not touch it again.
//
// It does nothing until the Renovate GitHub App is installed on this
// repository (https://github.com/apps/renovate). A person does that, under
// the organisation's or the account's settings. Until then no pull request is
// opened and nothing reports an error.
//
// It also opens the pull request that fixes a known advisory, from the
// repository's Dependabot alerts (a setting, which must be on). A fix does not
// wait for the schedule or the week below. Dependabot security updates, the
// other setting, stay off: with both on, each fix would arrive twice, and
// `pnpm repo:settings` fails while they are on.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // Every action in a workflow is pinned by its commit. Renovate moves the
    // commit and the version comment beside it together.
    "helpers:pinGitHubActionDigests"
  ],

  // A release that turns out to be malicious is usually found and removed
  // within days. Waiting a week means it is rarely installed here. Never set
  // this below `minimumReleaseAge` in pnpm-workspace.yaml (a day): pnpm
  // refuses a younger release, so the pull request could not update the
  // lockfile.
  "minimumReleaseAge": "7 days",
  // Hold an update back until it is old enough. Without this the pull request
  // opens at once with a pending check.
  "internalChecksFilter": "strict",

  // One wave, on Monday (UTC). Without a schedule a merged pull request is
  // replaced by the next at once, and the list never looks finished. The whole
  // day, not a few hours of it: the app does not run every repository in every
  // window, and a missed one waits a week.
  "schedule": ["on monday"],
  // How many may be open at once. The rest wait on the Dependency Dashboard
  // issue, which is where the whole list is.
  "prConcurrentLimit": 5,

  "vulnerabilityAlerts": {
    "enabled": true
  },

  // `tools/` holds what the kit and the add-ons installed. An update of the
  // add-on replaces those files, and refuses one that was changed here.
  "ignorePaths": ["**/node_modules/**", "tools/**"],

  "customManagers": [
    {
      // A workflow's Playwright image is read as the npm package it carries,
      // so the two move to one version: a project's `playwright-pin` gate
      // fails when they differ. An image tag has no release date, so the
      // week's wait above could not hold the image back on its own.
      "customType": "regex",
      "description": "The Playwright image of a workflow, at the version of @playwright/test",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-noble"],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    }
  ],

  "packageRules": [
    {
      // Minor and patch releases arrive as one pull request. A major release
      // gets its own, because it is the one that needs reading.
      "groupName": "minor and patch",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      // The actions the workflows use, in one pull request. After the rule
      // above, so that it wins for an action: a later rule overrides.
      "groupName": "actions",
      "matchManagers": ["github-actions"]
    },
    {
      // Playwright is pinned in a package, in the performance add-on's root
      // dependency and in the image of each browser workflow, and the goldens
      // were drawn by one version of it. Moving it is a piece of work (the
      // goldens are drawn again), begun from the Dependency Dashboard, not on
      // a Monday. After the two rules above, so that it wins.
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/test"],
      "dependencyDashboardApproval": true
    },
    {
      // The image is read above, as the npm package.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "enabled": false
    },
    {
      // Nothing in pnpm-workspace.yaml is moved. Its `overrides` are pins
      // written by hand for one advisory each, with the condition for
      // dropping them beside each one. Renovate reads an override as an
      // ordinary dependency and would lift it to the next major.
      "matchFileNames": ["pnpm-workspace.yaml"],
      "enabled": false
    }
  ]
}

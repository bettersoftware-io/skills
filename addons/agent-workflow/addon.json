{
  "name": "agent-workflow",
  "summary": "How an agent ships work: a hook that keeps each push and pull request step in a call of its own, a worktree script and an audit of worktrees, a page of what is left, a weekly tag, a changelog that is checked and reminded of at the start of a session, GitHub Releases made from it, and a writer for it that a project can switch on.",
  "recommended": true,
  "packageJson": {
    ".": {
      "scripts": {
        "worktree": "node tools/agent-workflow/new-worktree.mts",
        "worktree:audit": "node tools/agent-workflow/audit-worktrees.mts",
        "changelog": "node tools/agent-workflow/changelog.mts",
        "changelog:releases": "node tools/agent-workflow/sync-releases.mts",
        "agent-workflow:check": "node tools/agent-workflow/check.mts",
        "check:status": "node tools/agent-workflow/check-status.mts"
      }
    }
  },
  "gates": {
    "fast": [
      "pnpm check:status"
    ],
    "full": []
  },
  "startingFiles": [
    "CHANGELOG.md",
    "docs/STATUS.md",
    "docs/IDEAS.md"
  ],
  "retiredFiles": {
    "tools/agent-workflow.config.json": {
      "note": "It set what the hook let run without a prompt. The hook no longer lets anything run without one, whatever this file says: the add-on's README says why. Delete the file."
    },
    "tools/agent-workflow.config.mts": {
      "note": "It set what the hook let run without a prompt. The hook no longer lets anything run without one, whatever this file says: the add-on's README says why. Delete the file."
    }
  },
  "retiredHookCommands": {
    "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/split-outward-commands.mts\" --host=claude-code": "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/split-outward-commands.mts\""
  },
  "hostSettings": {
    ".claude/settings.json": {
      "permissions": {
        "ask": [
          "Bash(git push *--force*)",
          "Bash(git push -f*)",
          "Bash(git push * -f*)",
          "Bash(git push * +*)",
          "Bash(git push *--delete*)",
          "Bash(git push -d*)",
          "Bash(git push * -d*)",
          "Bash(git push *--mirror*)",
          "Bash(git push *--all*)",
          "Bash(git push *--tags*)",
          "Bash(git push *--prune*)",
          "Bash(gh pr merge *--admin*)",
          "Bash(pnpm changelog tag *--apply*)",
          "Bash(pnpm changelog:releases *--apply*)",
          "Bash(pnpm run changelog tag *--apply*)",
          "Bash(node tools/agent-workflow/changelog.mts tag *--apply*)",
          "Bash(pnpm run changelog:releases *--apply*)",
          "Bash(node tools/agent-workflow/sync-releases.mts *--apply*)",
          "Edit(/tools/agent-workflow/**)"
        ]
      },
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/split-outward-commands.mts\"",
                "timeout": 5
              }
            ]
          },
          {
            "matcher": "Monitor",
            "hooks": [
              {
                "type": "command",
                "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/split-outward-commands.mts\"",
                "timeout": 5
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "startup|resume|clear",
            "hooks": [
              {
                "type": "command",
                "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/changelog-due.mts\"",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    ".codex/hooks.json": {
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node tools/agent-workflow/hooks/split-outward-commands.mts",
                "statusMessage": "Checking how the command is joined",
                "timeout": 5
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "startup|resume",
            "hooks": [
              {
                "type": "command",
                "command": "node tools/agent-workflow/hooks/changelog-due.mts",
                "statusMessage": "Checking the changelog",
                "timeout": 5
              }
            ]
          }
        ]
      }
    }
  },
  "verify": "pnpm agent-workflow:check",
  "releaseNotes": [
    {
      "id": "0.20.0",
      "notes": [
        "Sessions now start with the changelog weeks that are due. In Codex, trust the new hook with `/hooks`.",
        "`pnpm changelog check` now fails a definitions block that differs from what `pnpm changelog defs --write` writes, and a citation in the wrong week. Run `pnpm changelog defs --write` once.",
        "The new workflows `sync-releases.yml` and `changelog-writer.yml` are skipped until the repository variable `CHANGELOG_RELEASES` or `CHANGELOG_WRITER` is `true`. The README says how to switch each on, and what the writer costs.",
        "Tags are now dated by their week: `changelog tag` and the weekly tag give a tag the Monday 00:05 UTC after its week."
      ]
    }
  ]
}

{
  "description": "Architecture gates: judge each written file, and refuse to finish on a red gate.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node tools/arch/hooks/after-edit.mts", "statusMessage": "Checking architecture rules", "timeout": 20 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node tools/arch/hooks/watch-subagents.mts", "statusMessage": "Recording the subagent", "timeout": 20 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node tools/arch/hooks/watch-subagents.mts", "statusMessage": "Running the gate", "timeout": 600 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node tools/arch/hooks/before-stop.mts", "statusMessage": "Running the gate", "timeout": 600 }
        ]
      }
    ]
  }
}

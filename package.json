{
  "name": "bettersoftware-skills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc6 -p tsconfig.json",
    "gates": "node kit/gates/run.mts",
    "evals:trigger": "node scripts/evals-preflight.mts && claude plugin eval . --tag trigger --ablation none --scaffold --model sonnet --no-publish",
    "evals:outcome": "node scripts/evals-preflight.mts && claude plugin eval . --tag outcome --ablation with-without --scaffold --model sonnet --judge-model haiku --no-publish",
    "evals:codex": "node scripts/evals-codex.mts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@typescript-eslint/utils": "^8.70.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.17.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  }
}
